# Copy to render.env, fill in values, then Render Dashboard → Environment → "Add from .env"
# Do NOT commit render.env (contains secrets)

NODE_ENV=production
FRONTEND_URL=https://smart-scheduling-eta.vercel.app

# REQUIRED — replace with your Atlas connection string (NOT localhost)
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.YOUR_CLUSTER.mongodb.net/smart-scheduling?retryWrites=true&w=majority

JWT_SECRET=change_to_long_random_string_at_least_32_chars
REFRESH_TOKEN_SECRET=change_to_different_long_random_string

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Smart Scheduling <your_email@gmail.com>
